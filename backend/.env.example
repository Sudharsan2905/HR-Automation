# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=skill_mate

# JWT
JWT_SECRET_KEY=change-me-to-a-random-256-bit-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_CANDIDATE_TOKEN_EXPIRE_MINUTES=90

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=SkillMate


# LLM — openai | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@skillmate.com
SUPER_ADMIN_PASSWORD=change-me

# App
APP_NAME=SkillMate
APP_URL=https://your-ngrok-or-domain-url.com
CORS_ORIGINS=["http://localhost:3000", "http://192.168.14.48:3000"]

# --- Merged Level 1 (AI exam) + hiring flow ---
SMTP_FROM=                      # sender address (Brevo etc.: the login is not a valid From address)
SUPER_ADMIN_EMAIL=super.admin@skillmate.com
SUPER_ADMIN_PASSWORD=change-me
LEVEL1_PASS_PERCENT=75          # candidates must score ABOVE this to pass Level 1
LEVEL1_QUESTION_MODEL=gpt-4o
LEVEL1_ANALYSIS_MODEL=gpt-4o-mini
LEVEL1_EXAM_MINUTES=60
LEVEL1_KEY_TTL_HOURS=72         # Level 1 access key lifetime (also ends on submission)
LEVEL1_STORAGE_PATH=./level1_files
HIRING_AUTO_SELECT=true         # auto-select shortlisted profiles that have an email
# gpt-4o allows at most 16384 output tokens; the 32000 default needs a reasoning model
LLM_MAX_TOKENS_SOURCING=16000
