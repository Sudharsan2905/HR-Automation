{
  "manifest_version": 3,
  "name": "SkillMate Sourcing",
  "version": "1.0.0",
  "description": "Sources candidates from Naukri ResDex for SkillMate JDs. Searches, screening and selection happen in SkillMate.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SkillMate Sourcing",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.naukri.com/*",
    "https://naukri.com/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.naukri.com/*",
        "https://naukri.com/*"
      ],
      "js": [
        "core.js",
        "naukri.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*"
      ],
      "js": [
        "config.js",
        "core.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
